<section class="legendkeeper sheet">
  <p class="lk-sync" data-state="{{syncState}}">{{syncLabel}}</p>
  {{#if syncError}}<p class="lk-sync-error">{{syncError}}</p>{{/if}}
  {{#if migrationRequired}}
    <p class="lk-migration">This page has blocks without stable ids. Editing stays disabled until you authorize a one-time id migration.</p>
    <button type="button" data-action="migrateIds">Assign block ids</button>
  {{/if}}
  <div class="lk-body">{{{rendered}}}</div>
  {{#if editable}}
    <fieldset class="lk-runs" data-block-id="{{editBlockId}}" data-base-version="{{baseVersion}}" data-resource-id="{{lkResourceId}}" data-document-id="{{lkDocumentId}}">
      <input type="hidden" name="sourceRuns" value="{{sourceRuns}}">
      <legend>Paragraph runs</legend>
      {{#each runs}}
        <label class="lk-run" data-kind="{{kind}}" data-run-index="{{index}}">
          {{#if locked}}
            <span class="lk-run-break">Line break</span>
          {{else}}
            <input type="text" name="run-{{index}}" data-run-index="{{index}}" value="{{text}}">
          {{/if}}
          {{#if marks}}<span class="lk-run-meta">{{marks}}</span>{{/if}}
          {{#if link}}<span class="lk-run-meta">{{link}}</span>{{/if}}
          {{#if mentionId}}<span class="lk-run-meta">{{mentionId}}</span>{{/if}}
        </label>
      {{/each}}
      <button type="button" data-action="saveParagraph">Save paragraph</button>
    </fieldset>
  {{/if}}
</section>
